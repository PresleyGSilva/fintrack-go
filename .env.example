# Copy to .env (never commit the real .env)
PORT=8080
DATABASE_URL=postgres://fintrack:fintrack@localhost:5437/fintrack?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
SEED_DEMO=true
FRONTEND_ORIGINS=http://localhost:3004,http://localhost:3000

# Compose port overrides
API_PORT=8084
WEB_PORT=3004
DB_PORT=5437

# Postgres (compose)
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=fintrack
POSTGRES_DB=fintrack

# Frontend (build arg / local dev)
NEXT_PUBLIC_API_URL=http://localhost:8084
